# Copy to .env and fill in. Never commit .env — it is gitignored, and the
# Docker build excludes it so keys are never baked into an image layer.
#
#     cp .env.example .env

# ---------------------------------------------------------------- chat LLM --
# Any OpenAI-compatible /v1/chat/completions endpoint.
OPENAI_URL=https://your-provider/v1/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=

# -------------------------------------------------------------- embeddings --
# A SEPARATE model and endpoint from the chat LLM. OPENAI_MODEL is never used
# for embeddings, and pointing both at one model is the most common setup
# mistake here.
#
# Resolution order: EMBEDDING_BASE_URL → {OLLAMA_URL}/v1 → OPENAI_URL as /v1.
EMBEDDING_BASE_URL=https://your-provider/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Running Ollama on the host while the API is in Docker? The container cannot
# see the host's localhost; docker-compose.yml maps host.docker.internal for it:
#   EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_MODEL=bge-m3

# ---------------------------------------------------------- service (API_*) --
# All optional; the defaults below are what the code uses.
#
# API_HOST=0.0.0.0                    # set by the image; 127.0.0.1 on a laptop
# API_PORT=8000
# API_MAX_UPLOAD_BYTES=67108864       # 64 MB — keep nginx's client_max_body_size in step
# API_MAX_CONCURRENT_INDEX_JOBS=2     # embedding is network-bound, not CPU-bound
# API_INDEX_BUDGET_SECONDS=600        # the spec's 10 minutes per document
# API_FETCH_TIMEOUT_SECONDS=30
#
# Add-by-URL refuses private, loopback and link-local addresses so the service
# cannot be pointed at its own cloud metadata endpoint. Enable only when the
# document store is genuinely on the internal network.
# API_ALLOW_PRIVATE_NETWORK_FETCH=false
#
# Some archives refuse anonymous clients. SEC's fair-access policy wants a
# contact address and answers 403 without one.
# API_FETCH_USER_AGENT=Acme Research analyst@acme.com
