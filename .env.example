# Copy to .env and fill in. Never commit .env — it is gitignored, and the
# Docker build excludes it so keys are never baked into an image layer.
#
#     cp .env.example .env

# ---------------------------------------------------------------- chat LLM --
# Any OpenAI-compatible /v1/chat/completions endpoint.
OPENAI_URL=https://your-provider/v1/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=

# ------------------------------------------------------------------ price --
# What a token costs, in USD per million tokens. Optional, and deliberately
# unset by default.
#
# Every answer reports the tokens it spent. It reports a *cost* only when a rate
# is configured here (or the model is one whose list price ships in
# `usage/pricing.py`). Nothing is guessed: an OpenAI-compatible gateway can put
# any model behind any name at any margin, and a dollar figure invented from an
# assumed rate is worse than none — an analyst will act on it.
#
# Left unset, the UI shows "no price configured" beside the token count.
# Zero is a legitimate setting for a model you host yourself.
CHAT_PRICE_INPUT=
CHAT_PRICE_OUTPUT=
# Optional. Rate for input the provider served from its own cache. Falls back to
# CHAT_PRICE_INPUT, which is the conservative reading.
CHAT_PRICE_CACHED_INPUT=

# Optional peak pricing, for a provider that charges more during its busy hours.
# Set these and a window and the rates above become the OFF-PEAK tier; the rate
# is then resolved per call against the clock, which is how such a provider
# bills. Leave them and the price is flat.
#
# Worked example -- deepseek-v4-flash on OpenCode Zen, verified 27 Aug 2026:
#   CHAT_PRICE_INPUT=0.22
#   CHAT_PRICE_OUTPUT=0.66
#   CHAT_PRICE_CACHED_INPUT=0.007
#   CHAT_PRICE_PEAK_INPUT=0.44
#   CHAT_PRICE_PEAK_OUTPUT=1.32
#   CHAT_PRICE_PEAK_CACHED_INPUT=0.014
#   CHAT_PRICE_PEAK_HOURS_UTC=01-04,06-10
CHAT_PRICE_PEAK_INPUT=
CHAT_PRICE_PEAK_OUTPUT=
CHAT_PRICE_PEAK_CACHED_INPUT=
# Half-open UTC hour windows, comma separated. Empty means never peak.
CHAT_PRICE_PEAK_HOURS_UTC=

# Optional. Embeddings return vectors, not tokens, so there is no output rate.
# qwen/qwen3-embedding-8b on OpenRouter is 0.01 (verified 27 Aug 2026).
EMBEDDING_PRICE_INPUT=

# -------------------------------------------------------------- embeddings --
# A SEPARATE model and endpoint from the chat LLM. OPENAI_MODEL is never used
# for embeddings, and pointing both at one model is the most common setup
# mistake here.
#
# Resolution order: EMBEDDING_BASE_URL → {OLLAMA_URL}/v1 → OPENAI_URL as /v1.
EMBEDDING_BASE_URL=https://your-provider/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Running Ollama on the host while the API is in Docker? The container cannot
# see the host's localhost; docker-compose.yml maps host.docker.internal for it:
#   EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_MODEL=bge-m3

# ---------------------------------------------------------- service (API_*) --
# All optional; the defaults below are what the code uses.
#
# API_HOST=0.0.0.0                    # set by the image; 127.0.0.1 on a laptop
# API_PORT=8000
# API_MAX_UPLOAD_BYTES=67108864       # 64 MB — keep nginx's client_max_body_size in step
# API_MAX_CONCURRENT_INDEX_JOBS=2     # embedding is network-bound, not CPU-bound
# API_INDEX_BUDGET_SECONDS=600        # the spec's 10 minutes per document
# API_FETCH_TIMEOUT_SECONDS=30
#
# Add-by-URL refuses private, loopback and link-local addresses so the service
# cannot be pointed at its own cloud metadata endpoint. Enable only when the
# document store is genuinely on the internal network.
# API_ALLOW_PRIVATE_NETWORK_FETCH=false
#
# Some archives refuse anonymous clients. SEC's fair-access policy wants a
# contact address and answers 403 without one.
# API_FETCH_USER_AGENT=Acme Research analyst@acme.com

# ------------------------------------------------------------- chat history --
# Postgres connection for chat history. Inside docker compose this is set by
# docker-compose.yml (db/migrate services) and needs no .env entry; set it
# only when running the API outside the stack:
#
#   DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst
#
# When unset, the API answers questions normally but records no history: the
# /conversations endpoints return 503 database_unavailable.

# ---------------------------------------------------------------------------
# Agent harness
# ---------------------------------------------------------------------------
# A question is answered at the cheapest tier that can prove itself: hybrid
# retrieval, then a second reader checking that answer against the whole cited
# page, then -- only if neither produced something provable -- every page of the
# filing read by parallel agents. See docs/16-agent-harness.md.
#
# The defaults are what the eval was measured with; every one is optional.

# Turn off the second-opinion check. Faster, and serves any answer whose figures
# trace to its cited page -- which misses the right-figure-wrong-question case.
# AGENT_VALIDATE_ANSWERS=true

# Turn off whole-document search. The system then abstains where it would have
# read the filing, which is cheaper and scores 0 instead of possibly +1.
# AGENT_DEEP_SEARCH=true

# Pages one reader agent is responsible for. Every page belongs to exactly one
# reader, so the readers together have read the whole document.
# AGENT_PAGES_PER_SHARD=10

# Readers in flight at once. Bounded by the provider's rate limit, not local
# CPU: readers spend all their time waiting on network calls.
# AGENT_MAX_CONCURRENCY=8

# Hard cap on readers for one question. 0 means no cap -- a 306-segment filing
# runs 31 readers. Set it only to bound cost, and note that a cap means the
# document was not fully read (it is logged when that happens).
# AGENT_MAX_SHARDS=0

# Split a question that asks several things into parts, each cited separately.
# AGENT_DECOMPOSE=true
# AGENT_MAX_PARTS=4

# Prior turns shown to the harness, so "and the year before?" resolves.
# AGENT_HISTORY_TURNS=6
