# Environment and secrets
.env
.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/

# Generated indices / embeddings
storage/

# Filings added through the UI. The practice corpus is the loose .htm files
# directly under filings/; every subdirectory is a user-created filing holding
# their own uploads, which are theirs and are regenerable from the source they
# came from.
filings/*/
*.npz
*.faiss

# Eval runs (model output)
data/*
data/eval-results.json
data/eval-results*.json
data/eval-scores*.json
data/eval-after-fix.json
data/eval-20.json
data/questions-by-doc-results.json

# OS / IDE
.DS_Store
.idea/
.vscode/

# others
review/*
scripts/eval/*


# Logs
*.log
