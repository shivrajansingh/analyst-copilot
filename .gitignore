# Environment and secrets
.env
.env.*
# ...except the template, which carries no secrets and is what the README and
# the Docker setup tell you to copy.
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
temp/*
build/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Data, not code
# ---------------------------------------------------------------------------

# The filing corpus. 338 MB of 10-Ks that arrived with the challenge zip and
# that no commit should carry: it is input data, it never changes, and it
# dwarfs everything else in the repository.
#
# The directory itself is still where the code expects it —
# `settings.filings_dir` is PROJECT_ROOT/"filings" — and it is both the corpus
# location and where documents uploaded through the UI land. A fresh clone has
# to repopulate it from the challenge zip before the tests, `index_all.py` or
# the eval scripts can run.
filings/
# ...including when it is a symlink into wherever the corpus actually lives.
# `filings/` with a trailing slash matches a directory only, and a fresh clone
# that symlinks the corpus in would otherwise see it as an untracked file.
/filings

# Generated indices, embeddings and per-page Markdown. Hours of embedding, all
# of it reproducible from filings/ by `scripts/index_all.py`.
storage/
*.npz
*.faiss

# Eval runs and working copies of the corpus. The practice key and its derived
# question map are the exceptions: they are small, they are the scoring
# authority, and the eval scripts do not run without them.
data/*
!data/README.md
!data/practice-questions.jsonl
!data/questions-by-doc.json

# Codebase review notes and dry-run model output — a snapshot of one session,
# not something later commits should keep re-stating.
review/

